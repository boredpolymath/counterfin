# Template for GitHub Actions Code Signing Secrets
# Copy this file to .secrets.env (which is .gitignored), fill in your values, and run:
#   gh secret set -f .secrets.env
#
# NOTE: For certificates, generate the base64 string using:
#   base64 -i your_cert.p12 | tr -d '\n'
# Or simply run the automated helper: ./scripts/setup_signing_secrets.sh

# macOS Developer ID Signing & Notarization
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name/Company (TEAM_ID)"
APPLE_ID="your-apple-id@example.com"
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID="XXXXXXXXXX"
APPLE_CERTIFICATE_PASSWORD="your-p12-password"
# APPLE_CERTIFICATE="<paste base64-encoded p12 string here>"

# Windows Authenticode Signing
# WINDOWS_CERTIFICATE="<paste base64-encoded pfx string here>"
WINDOWS_CERTIFICATE_PASSWORD="your-pfx-password"
