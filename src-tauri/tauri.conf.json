{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SettleMint",
  "version": "0.1.2",
  "identifier": "com.boredpolymath.settlemint",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [

      {
        "label": "main",
        "title": "SettleMint — Consumer Credit Shield & Debt Collector Dispute Console",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:;"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkKUldSYmNmOVlMUk55dWJ2V0hZNmVRcWJ4N1ZtZXN1S0hKWHhhU29nVTN0YTF3L3R1Mkx1bXQ4NEEK",
      "endpoints": [
        "https://github.com/boredpolymath/settlemint/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "SettleMint: Consumer Credit Shield & Debt Collector Dispute Console",
    "longDescription": "Free, open-source, local-first desktop application that empowers consumers to defend against debt collectors, track statutory deadlines, catch illegal collection practices, and generate formal dispute letters.",
    "copyright": "Copyright © 2026 Bored Polymath Studios",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
